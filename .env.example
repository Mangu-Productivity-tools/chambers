# Auth stays off. Do not set VITE_AUTH_ENABLED=true unless you add accounts.
VITE_AUTH_ENABLED=false

# AI assist is not shipped. Leave this unset (off). It is a flag, not a secret.
# Unsetting it in Vercel and redeploying is the kill switch (docs/RUNBOOK.md).
# VITE_ASSIST_ENABLED=

# Server-only. Only read when VITE_ASSIST_ENABLED=true. Do not set in production.
# XAI_API_KEY=

# Unused in this build — no database, no accounts.
# DATABASE_URL=
